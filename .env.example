# ─── Supabase ────────────────────────────────────────────────────────────────
# Local: run `npm run db:start` and copy "API URL" and "Publishable key" from the output.
# Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secret key (never prefix with NEXT_PUBLIC_). Required for storefront
# checkout. Hosted: Project Settings → API Keys → Secret keys.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (checkout codes and order confirmations) ─────────────────────────
# Any SMTP provider. With Brevo use the same login and SMTP key as in Supabase.
# In development, if these are unset, codes are written to the server log instead.
# SMTP_USER/SMTP_PASSWORD can be left out for relays that need no login (e.g.
# the local Supabase stack's Mailpit: SMTP_HOST=127.0.0.1, SMTP_PORT=54325).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASSWORD=your-brevo-smtp-key
# MAIL_FROM="Shopverse <you@example.com>"

# Public URL of the app. In Codespaces this is your forwarded port URL,
# e.g. https://<codespace-name>-3000.app.github.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Hosted project ref, used by `npm run db:types:remote`
# SUPABASE_PROJECT_ID=abcdefghijklmnop

# --- Online payments (Stripe) -----------------------------------------------
# Each business connects its own Stripe account in Payments (test keys are
# fine: sk_test_…, no verification needed). Their secrets are
# encrypted with this key before being stored: 32 random bytes, base64.
#   openssl rand -base64 32
# Keep it secret and don't change it later (businesses would have to re-enter
# their keys). Without it, online payments stay off.
PAYMENTS_ENCRYPTION_KEY=
# Only for local testing against a stand-in; leave unset in real deployments.
# STRIPE_API_URL=https://api.stripe.com

# --- Scheduler (low-stock alerts, daily digest) ------------------------------
# Something must call POST /api/cron/operations every ~15 minutes with
# "Authorization: Bearer <CRON_SECRET>" (see .github/workflows/operations-cron.yml).
#   openssl rand -hex 24
# CRON_SECRET=

# --- WhatsApp & SMS (Twilio) ------------------------------------------------
# Each business enters its own Twilio keys in the app (encrypted with
# PAYMENTS_ENCRYPTION_KEY). Only for local testing against a stand-in:
# TWILIO_API_URL=https://api.twilio.com

# --- Custom domains (local development) --------------------------------------
# Extra hostnames next dev should accept, e.g. a test shop domain in /etc/hosts.
# DEV_EXTRA_HOSTS=shop.test,shop.test:3000

# --- Shopverse billing (plan subscriptions) ---------------------------------
# Shopverse's own Stripe account (not a business's). Add a webhook endpoint at
# <your app>/api/webhooks/stripe/platform for checkout.session.completed,
# customer.subscription.* and invoice.* events, and put its signing secret
# here. Without the key, plan changes are requested by email instead.
# PLATFORM_STRIPE_SECRET_KEY=sk_test_...
# PLATFORM_STRIPE_WEBHOOK_SECRET=whsec_...
# Printed on Shopverse's invoices to businesses. With a GSTIN, GST (18%) is added
# to plan prices and invoices are tax invoices.
# PLATFORM_LEGAL_NAME="Shopverse Technologies Pvt Ltd"
# PLATFORM_GSTIN=
# PLATFORM_ADDRESS="1 MG Road"
# PLATFORM_CITY=Bengaluru
# PLATFORM_STATE=Karnataka
# PLATFORM_POSTAL_CODE=560001
# PLATFORM_SAC_CODE=997331

# --- Errors and tracing (all optional) ---------------------------------------
# Errors are always stored in the database and shown at /admin/errors.
# Also send them to Sentry:
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# Export OpenTelemetry traces (Honeycomb, Grafana, Axiom…):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.honeycomb.io/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<key>
# Version tag on errors and traces (e.g. the git commit):
# APP_RELEASE=

# --- Rate limits ---------------------------------------------------------------
# Limits are kept in memory per server. With several servers or serverless,
# share them through Upstash Redis (free tier is plenty):
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
